{
  "pluginAlias": "Texecom",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Integrates Texecom Premier / Premier Elite panels via the Crestron protocol over a serial cable (PC-COM / USB-COM) or COM-IP. Configure **either** a serial device **or** an IP address.",
  "footerDisplay": "Arm/disarm from HomeKit requires the panel's UDL code and supports areas 1–8.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Texecom",
        "required": true,
        "description": "Shown in the Homebridge log. You shouldn't need to change this."
      },
      "ip_address": {
        "title": "IP Address",
        "type": "string",
        "format": "ipv4",
        "placeholder": "192.168.1.50",
        "description": "Address of the COM-IP module. Leave blank when using a serial connection."
      },
      "ip_port": {
        "title": "IP Port",
        "type": "integer",
        "default": 10001,
        "minimum": 1,
        "maximum": 65535
      },
      "serial_device": {
        "title": "Serial Device",
        "type": "string",
        "placeholder": "/dev/ttyUSB0",
        "description": "Leave blank when using an IP connection."
      },
      "baud_rate": {
        "title": "Baud Rate",
        "type": "integer",
        "default": 19200,
        "oneOf": [
          { "title": "9600", "enum": [9600] },
          { "title": "19200 (typical)", "enum": [19200] },
          { "title": "38400", "enum": [38400] },
          { "title": "57600", "enum": [57600] },
          { "title": "115200", "enum": [115200] }
        ],
        "condition": {
          "functionBody": "return !!model.serial_device;"
        }
      },
      "udl": {
        "title": "UDL Code",
        "type": "string",
        "pattern": "^[0-9]{4,6}$",
        "placeholder": "1234",
        "description": "The panel's UDL code. Required to arm/disarm from HomeKit; without it areas are read-only."
      },
      "zones": {
        "title": "Zones",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Zone Name",
              "type": "string",
              "required": true
            },
            "zone_number": {
              "title": "Zone Number",
              "type": "integer",
              "minimum": 1,
              "maximum": 640,
              "required": true
            },
            "zone_type": {
              "title": "Zone Type",
              "type": "string",
              "default": "motion",
              "required": true,
              "oneOf": [
                { "title": "Motion", "enum": ["motion"] },
                { "title": "Contact (door/window)", "enum": ["contact"] },
                { "title": "Smoke", "enum": ["smoke"] },
                { "title": "Carbon Monoxide", "enum": ["carbonmonoxide"] }
              ]
            },
            "dwell": {
              "title": "Dwell Time (ms)",
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "description": "How long the sensor stays active after the panel reports the zone has cleared."
            }
          }
        }
      },
      "areas": {
        "title": "Areas",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Area Name",
              "type": "string",
              "required": true
            },
            "area_number": {
              "title": "Area Number",
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "required": true,
              "description": "Areas above 8 report status only; they cannot be armed from HomeKit."
            },
            "area_type": {
              "title": "Area Type",
              "type": "string",
              "default": "securitysystem",
              "enum": ["securitysystem"]
            },
            "zones": {
              "title": "Zones in this Area",
              "type": "array",
              "description": "Zone numbers that should show this area as triggered when activated while away-armed.",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 640
              }
            }
          }
        }
      },
      "debug": {
        "title": "Debug logging",
        "type": "boolean",
        "default": false,
        "description": "Log every message from the panel without enabling Homebridge-wide debug mode."
      }
    }
  },
  "layout": [
    "name",
    {
      "type": "fieldset",
      "title": "Connection",
      "items": ["ip_address", "ip_port", "serial_device", "baud_rate", "udl"]
    },
    {
      "key": "zones",
      "type": "array",
      "title": "Zones",
      "expandable": true,
      "expanded": false,
      "orderable": false,
      "buttonText": "Add zone",
      "items": [
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": ["zones[].name", "zones[].zone_number", "zones[].zone_type", "zones[].dwell"]
        }
      ]
    },
    {
      "key": "areas",
      "type": "array",
      "title": "Areas",
      "expandable": true,
      "expanded": false,
      "orderable": false,
      "buttonText": "Add area",
      "items": [
        "areas[].name",
        "areas[].area_number",
        {
          "key": "areas[].zones",
          "type": "array",
          "buttonText": "Add zone",
          "items": ["areas[].zones[]"]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "expanded": false,
      "items": ["debug"]
    }
  ]
}
